{
  "opencollection": "1.0.0",
  "info": {
    "name": "SerpApi Search Account API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve account information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://serpapi.com/account"
          },
          "docs": "Returns information about the SerpApi account associated with the API key."
        }
      ]
    }
  ],
  "bundled": true
}